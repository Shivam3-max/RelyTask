# ─── DATABASE (MySQL) ────────────────────────────────────────────────────────
# Set the parts individually — src/lib/db-url.ts assembles DATABASE_URL from
# them for Prisma (client, CLI, seed).
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="relytask"
DB_PASSWORD=""
DB_NAME="relytask"
# Optional extra query string, e.g. "connection_limit=5" or "sslmode=require"
DB_PARAMS=""
# Optional: set a full URL to override the parts above entirely.
# DATABASE_URL="mysql://user:pass@host:3306/db"

# ─── NEXTAUTH ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── FILE STORAGE ────────────────────────────────────────────────────────────
# Absolute path for user uploads. Leave blank locally (defaults to the project
# dir). In production (Hostinger etc.) point this at a directory OUTSIDE the
# deployed app so uploads survive redeploys, e.g.:
#   STORAGE_DIR="/home/uXXXXXXXX/storage/relytask"
STORAGE_DIR=""

# ─── EMAIL (SMTP) ────────────────────────────────────────────────────────────
# Works with Gmail, SendGrid, Postmark, Mailgun, etc.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"

# ─── TWILIO (WHATSAPP) ───────────────────────────────────────────────────────
# Leave empty to disable WhatsApp notifications
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Format: +14155238886 (Twilio Sandbox number or approved sender)
TWILIO_WHATSAPP_FROM=""

# ─── SEED ────────────────────────────────────────────────────────────────────
# Credentials for the default admin account created by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@relytask.com"
SEED_ADMIN_PASSWORD="ChangeMe@123"
# Temporary password given to every initial team member (see TEAM in seed.ts).
# They should change it on first login.
SEED_TEMP_PASSWORD="Rely@Temp2026"
